<?xml version="1.0"?>
<package format="2">
  <name>dig_trajectory_planner</name>
  <version>0.1.0</version>
  <description>
    无人挖掘机挖掘阶段关节空间轨迹规划模块。
    基于动态规划(DP)的三关节联合优化，最大化挖掘土方量。
  </description>
  <maintainer email="dev@example.com">yx</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
</package>
