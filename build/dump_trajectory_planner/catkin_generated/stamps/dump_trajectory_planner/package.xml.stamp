<?xml version="1.0"?>
<package format="2">
  <name>dump_trajectory_planner</name>
  <version>0.1.0</version>
  <description>
    无人挖掘机卸载阶段关节空间轨迹规划与执行节点。
    6 关键航路点 + 三次 Hermite 在线插值 + 反馈驱动推进 + 铲斗高度门控。
  </description>
  <maintainer email="dev@example.com">yx</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>kinematics</depend>
</package>
