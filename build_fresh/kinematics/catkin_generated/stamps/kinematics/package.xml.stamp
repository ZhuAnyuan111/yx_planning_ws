<?xml version="1.0"?>
<package format="2">
  <name>kinematics</name>
  <version>0.1.0</version>
  <description>
    挖掘机运动学求解库（ROS1 Noetic 版）。提供正向/逆向运动学接口，
    可通过 ros::NodeHandle 从参数服务器加载机构参数，也可直接通过纯
    C++ 结构体注入参数（无 ROS 依赖）。
  </description>

  <maintainer email="zhuay@example.com">zhuay</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
</package>
