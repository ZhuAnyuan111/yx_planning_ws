<launch>
  <!-- 抹平轨迹规划与执行节点 -->
  <!-- 装满车后沿车厢上表面从车尾向车头推抹刮平，seq_action==6.0 激活 -->

  <node pkg="smooth_trajectory_planner" type="smooth_trajectory_node"
        name="smooth_trajectory_node" output="screen">
    <rosparam command="load"
              file="$(find smooth_trajectory_planner)/config/smooth_trajectory.yaml"/>
  </node>
</launch>
