Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TruckEnvelope1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz/Views
    Expanded: ~
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    Experimental: false
    SyncMode: 0
    SyncSource: ~
Preferences:
  PromptSaveOnExit: true
Tool Manager:
  Class: ~
Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Focus
Views:
  Current:
    Class: rviz/Orbit
    Distance: 25
    Enable Stereo Rendering:
      Stereo Eye Separation: 0.06
      Stereo Focal Distance: 1
      Swap Stereo Eyes: false
      Value: false
    Focal Point:
      X: 2
      Y: 5
      Z: 2
    Focal Shape Fixed Size: true
    Focal Shape Size: 0.05
    Invert Z Axis: false
    Name: Current View
    Near Clip Distance: 0.01
    Pitch: 0.7
    Target Frame: base
    Yaw: 0.5
Visualization Manager:
  Class: ~
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Axes
      Enabled: true
      Length: 2
      Name: OriginAxes
      Radius: 0.1
      Reference Frame: base
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /truck_envelope_markers
      Name: TruckEnvelope
      Namespaces:
        {}
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: base
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 25
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 2
        Y: 5
        Z: 2
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7
      Target Frame: base
      Yaw: 0.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1280
  X: 100
  Y: 100
