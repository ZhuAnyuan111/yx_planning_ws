<?xml version="1.0"?>
<package format="2">
  <name>data_to_nas_and_ubuntu2204</name>
  <version>0.1.0</version>
  <description>C++ port of the SY200 NAS data collection and brain communication node.</description>

  <maintainer email="wuql17@example.com">wuql17</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>grid_map_msgs</build_depend>
  <build_depend>interfaces</build_depend>
  <build_depend>libcurl4-openssl-dev</build_depend>
  <build_depend>libssl-dev</build_depend>
  <build_depend>libjsoncpp-dev</build_depend>
  <build_depend>libyaml-cpp-dev</build_depend>
  <build_depend>libgstreamer1.0-dev</build_depend>
  <build_depend>libgstreamer-plugins-base1.0-dev</build_depend>
  <build_depend>libjpeg-dev</build_depend>
  <build_depend>libpng-dev</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>grid_map_msgs</exec_depend>
  <exec_depend>interfaces</exec_depend>
  <exec_depend>gstreamer1.0-plugins-base</exec_depend>
